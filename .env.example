# Munus environment variables — copy to .env.local for local dev, or add
# each one to the Claude Code environment settings (preferred for sessions:
# secrets never touch the repo or the chat).
# Never commit .env.local — .gitignore already excludes it.

# ── Supabase (create the project at supabase.com, EU region) ──────────────
# Project URL — Dashboard → Project Settings → API (looks like
# https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Public/browser key — called "anon" (legacy JWT) or "publishable"
# (sb_publishable_...) depending on dashboard version. Safe for the client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret — "service_role" (legacy) or "secret" (sb_secret_...).
# NEVER exposed to the browser; used by workers and admin API routes only.
# Also used for storage uploads and facts writes in /api/cv (TASK-104).
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for migrations — Dashboard → Connect →
# Session pooler URI (postgresql://...)
SUPABASE_DB_URL=

# ── Groq (console.groq.com → API Keys) ────────────────────────────────────
GROQ_API_KEY=

# ── Later waves (leave empty for now) ─────────────────────────────────────
# STRIPE_SECRET_KEY=            # W5 — payments
# STRIPE_WEBHOOK_SECRET=        # W5 — payments
# NEXT_PUBLIC_POSTHOG_KEY=      # W6 — analytics (EU host)
